# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------

# Postgres: pooled URL for the app, direct URL for migrations
# (both can be the same for a local database)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Signs logins. Generate with: npx auth secret
AUTH_SECRET=

# Public address of the site, e.g. https://yourblog.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cover image uploads in the dashboard (uploadthing.com)
UPLOADTHING_TOKEN=

# --- Optional -------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_DESCRIPTION=

# Only needed when running `next start` yourself (not on Vercel)
# AUTH_TRUST_HOST=true

# Sign in with Google; the button appears once both are set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (Resend); without a key, emails are written to the server log
RESEND_API_KEY=
EMAIL_FROM=

# Error tracking (sentry.io); the auth token, org and project upload
# source maps during builds
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Seed admin login (npm run db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
